# DeckVerse's own Vercel project only. NEVER commit real values.
# Use a dedicated Supabase PostgreSQL role with permission only on deckverse schema.
DECKVERSE_DATABASE_URL=postgresql://deckverse_app:<STRONG_PASSWORD>@<EXACT_SUPABASE_CONNECT_POOLER_HOST>:6543/postgres?sslmode=require

# Set up a separate LiveKit app/project (or explicitly authorized shared tenant).
LIVEKIT_URL=wss://your-deckverse.livekit.cloud
LIVEKIT_API_KEY=<SERVER_SIDE_KEY>
LIVEKIT_API_SECRET=<SERVER_SIDE_SECRET>
